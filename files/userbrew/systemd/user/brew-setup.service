[Unit]
Description=Setup Brew
Wants=multi-user.target
After=multi-user.target
ConditionPathExists=!%h/.config/.linuxbrew
ConditionPathExists=!%h/.userbrew
ConditionPathExists=/usr/share/homebrew.tar.zst

[Service]
Type=oneshot
ExecStart=mkdir -p %h/.userbrew
ExecStart=/usr/bin/mkdir -p /tmp/homebrew
ExecStart=/usr/bin/tar --zstd -xf /usr/share/homebrew.tar.zst -C /tmp/homebrew
ExecStart=/usr/bin/cp -R -T -n /tmp/homebrew/home/linuxbrew/.linuxbrew %h/.userbrew
ExecStart=/usr/bin/rm -rf /tmp/homebrew
ExecStart=/usr/bin/touch %h/.config/.linuxbrew

[Install]
WantedBy=default.target multi-user.target